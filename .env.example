# Helpdesk (from the Nordavo email)
HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# LLM: any OpenAI-compatible endpoint. Examples:
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=<a current Flash model>
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama            LLM_MODEL=qwen2.5:14b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# The reply checker runs on a different model: an independent second opinion, and on Groq's free tier
# its own token quota (limits are per model). Defaults to LLM_MODEL.
VERIFIER_MODEL=openai/gpt-oss-120b
# Seconds between LLM calls (free tiers allow ~10 requests/minute)
LLM_MIN_INTERVAL=0
# Prices per million tokens from your provider's official pricing page (paid tier), only used for
# the cost-per-100-tickets estimate. Leave 0 on a free tier, then fill in to report what it would cost.
PRICE_CURRENCY=USD
# Groq list prices (preview model; checked Nov 2026 via third-party trackers, confirm on groq.com)
PRICE_IN_PER_MTOK=0.80
PRICE_OUT_PER_MTOK=4.00
VERIFIER_PRICE_IN_PER_MTOK=0.15
VERIFIER_PRICE_OUT_PER_MTOK=0.60
# Below this the agent counts itself unsure and hands off
MIN_CONFIDENCE=0.75

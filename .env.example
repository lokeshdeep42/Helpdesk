# Helpdesk (from the Nordavo email)
HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# LLM: any OpenAI-compatible endpoint. The primary (LLM_*) is tried first; LLM_FALLBACKS are tried in order
# when a model is out of quota, down, or missing. A model that fails is skipped for the rest of the run, and
# if every model is down the ticket stays open for the next run. Each decision's log says which model made it.
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_NAME=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# The reply checker runs on a different model: an independent second opinion with its own free-tier quota.
# Defaults to LLM_MODEL.
VERIFIER_MODEL=gemini-flash-lite-latest
# Seconds between calls: Gemini's free tier allows about 10 requests a minute
LLM_MIN_INTERVAL=7
# Prices per million tokens from your provider's official pricing page (paid tier), only used for
# the cost-per-100-tickets estimate. Leave 0 on a free tier, then fill in to report what it would cost.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# Fallbacks: each NAME here reads NAME_BASE_URL, NAME_API_KEY, NAME_MODEL, NAME_VERIFIER_MODEL,
# NAME_MIN_INTERVAL, NAME_PRICE_IN_PER_MTOK, NAME_PRICE_OUT_PER_MTOK, NAME_VERIFIER_PRICE_*_PER_MTOK.
LLM_FALLBACKS=groq,ollama

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VERIFIER_MODEL=openai/gpt-oss-120b
GROQ_MIN_INTERVAL=2
# Groq list prices (preview model; checked Nov 2026 via third-party trackers, confirm on groq.com)
GROQ_PRICE_IN_PER_MTOK=0.80
GROQ_PRICE_OUT_PER_MTOK=4.00
GROQ_VERIFIER_PRICE_IN_PER_MTOK=0.15
GROQ_VERIFIER_PRICE_OUT_PER_MTOK=0.60

# Local: skipped automatically until the model is pulled (`ollama pull qwen3:8b`) and Ollama is running.
# On a 16 GB laptop with a 4 GB GPU, stay at 7-8B (14B works but is slow).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

PRICE_CURRENCY=USD
# Below this the agent counts itself unsure and hands off
MIN_CONFIDENCE=0.75

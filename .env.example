# Helpdesk (from the Nordavo email)
HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# LLM: any OpenAI-compatible endpoint. Examples:
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (local):     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama            LLM_MODEL=qwen2.5:14b
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Optional: a different model for the reply checker (defaults to LLM_MODEL)
VERIFIER_MODEL=
# Seconds between LLM calls (free tiers allow ~10 requests/minute)
LLM_MIN_INTERVAL=0
# Prices in EUR per million tokens, only used for the cost estimate
PRICE_IN_PER_MTOK=0.28
PRICE_OUT_PER_MTOK=2.30
# Below this the agent counts itself unsure and hands off
MIN_CONFIDENCE=0.75
